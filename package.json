{
  "name": "chess-repertoire",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "check": "tsx scripts/tree-check.ts && tsx scripts/drill-check.ts && tsx scripts/pgn-check.ts && tsx scripts/deviation-check.ts",
    "check:mobile": "node scripts/mobile-check.mjs",
    "check:e2e": "node scripts/e2e-drill.mjs && node scripts/e2e-import.mjs && node scripts/e2e-games.mjs",
    "check:pwa": "npm run build && node scripts/pwa-check.mjs"
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "idb-keyval": "^6.3.0",
    "react": "^19.2.8",
    "react-chessboard": "^5.12.0",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "playwright": "^1.62.1",
    "tsx": "^4.23.9",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0"
  }
}
